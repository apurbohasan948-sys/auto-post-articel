# GEMINI_API_KEY: Optional/Default Gemini AI API key (injected in AI Studio)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted (or Netlify production URL)
APP_URL="MY_APP_URL"

# PRIMARY AI PROVIDER (OpenRouter / Custom OpenAI / Gemini)
OPENROUTER_API_KEY=""
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_DEFAULT_MODEL="anthropic/claude-3.5-sonnet"

# CUSTOM OPENAI-COMPATIBLE PROVIDERS
CUSTOM_AI_1_API_KEY=""
CUSTOM_AI_1_BASE_URL="https://api.openai.com/v1"
CUSTOM_AI_1_MODEL="gpt-4o"

# WEB RESEARCH PROVIDERS (Tavily is primary)
TAVILY_API_KEY=""
TAVILY_BASE_URL="https://api.tavily.com"

# GOOGLE BLOGGER API & OAUTH
BLOGGER_CLIENT_ID=""
BLOGGER_CLIENT_SECRET=""
BLOGGER_REDIRECT_URI="https://your-domain.netlify.app/api/blogger/oauth/callback"
BLOGGER_REFRESH_TOKEN=""
BLOGGER_DEFAULT_BLOG_ID=""

# SOCIAL MEDIA DISTRIBUTION KEYS
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
FACEBOOK_PAGE_ACCESS_TOKEN=""
FACEBOOK_PAGE_ID=""

TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
LINKEDIN_ACCESS_TOKEN=""

X_API_KEY=""
X_API_SECRET=""
X_ACCESS_TOKEN=""
X_ACCESS_SECRET=""

THREADS_ACCESS_TOKEN=""

# AGENT SECURITY & ADMIN AUTH
ADMIN_API_SECRET="your-secure-admin-token-here"
NETLIFY_SCHEDULER_SECRET=""

# STORAGE / PERSISTENCE (File-based DB or PostgreSQL / Firestore URL)
DATABASE_URL=""
STORAGE_DATA_DIR="./data"
